    "İçerik sağlamıyoruz": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We provide no content"
          }
        }
      }
    },
    "İçerik sağlamıyoruz. Uygulama kanal, liste veya yayın içermez, barındırmaz ve önermez. Yalnızca kendi eklediğiniz ve kullanma hakkınız olan kaynakları oynatır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We provide no content. The app does not contain, host or recommend channels, lists or streams. It only plays sources you add and have the right to use."
          }
        }
      }
    },
