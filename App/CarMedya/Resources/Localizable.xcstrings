    "Tüm bağlantılar kullanımda; yeni yayın reddedilebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All connections are in use; a new stream may be refused."
          }
        }
      }
    },
    "UDP yayınları desteklenmiyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP streams are not supported."
          }
        }
      }
    },
    "User-Agent (isteğe bağlı)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-Agent (optional)"
          }
        }
      }
    },
    "Uygulama içerik sağlamaz. Kaynaklar sekmesinden kendi listenizi, hesabınızı veya dosyanızı ekleyin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app provides no content. Add your own list, account or file in the Sources tab."
          }
        }
      }
    },
    "Uygulama içerik sağlamaz. Kendi M3U listenizi, Xtream hesabınızı veya bir dosyayı ekleyin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app provides no content. Add your own M3U list, Xtream account or a file."
          }
        }
      }
    },
    "Vazgeç": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "Veri toplanmaz. Kaynak adresleri ve parolalar yalnızca bu cihazda saklanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No data is collected. Source addresses and passwords are stored only on this device."
