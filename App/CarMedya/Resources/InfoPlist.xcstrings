    "NSLocalNetworkUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ağınızdaki kendi medya sunucunuza ve listelerinize bağlanmak için kullanılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to connect to your own media server and lists on your local network."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Info.plist",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç hareket halindeyken telefonda videoyu durdurup yalnız ses çalmak için hızınız kullanılır. Konum kaydedilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your speed is used to stop video on the phone and play audio only while the car is moving. Location is not stored."
          }
        }
      }
    }
  },
  "version": "1.0"
}
